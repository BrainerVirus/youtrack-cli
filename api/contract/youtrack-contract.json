{
  "$comment": "The YouTrack REST API surface ytrack uses, written by hand from the public API docs (https://www.jetbrains.com/help/youtrack/devportal/youtrack-rest-api.html). Endpoints list the query parameters ytrack sends and the entity they return (empty when ytrack reads no body). Types list the attributes ytrack requests in fields= or writes in a request body ($type, the discriminator every entity has, is implied as an attribute; the $type values ytrack writes are listed under subtypes, by the type they specialize), each with the entity types it may hold (empty for a scalar). internal/youtrack/adapter/contract_test.go checks every request against this file; the weekly openapi-contract workflow checks this file against the live schema.",
  "endpoints": [
    {"method": "GET", "path": "/users/me", "query": ["fields"], "response": "User"},
    {"method": "GET", "path": "/issues", "query": ["fields", "query", "customFields", "$skip", "$top"], "response": "Issue"},
    {"method": "GET", "path": "/issues/{id}", "query": ["fields"], "response": "Issue"},
    {"method": "GET", "path": "/issues/{id}/comments", "query": ["fields", "$skip", "$top"], "response": "IssueComment"},
    {"method": "POST", "path": "/issues/{id}/comments", "query": ["fields"], "response": "IssueComment"},
    {"method": "GET", "path": "/issues/{id}/timeTracking/workItems", "query": ["fields", "$skip", "$top"], "response": "IssueWorkItem"},
    {"method": "POST", "path": "/issues/{id}/timeTracking/workItems", "query": ["fields"], "response": "IssueWorkItem"},
    {"method": "GET", "path": "/issues/{id}/timeTracking/workItems/{issueWorkItemId}", "query": ["fields"], "response": "IssueWorkItem"},
    {"method": "POST", "path": "/issues/{id}/timeTracking/workItems/{issueWorkItemId}", "query": ["fields"], "response": "IssueWorkItem"},
    {"method": "DELETE", "path": "/issues/{id}/timeTracking/workItems/{issueWorkItemId}", "query": [], "response": ""},
    {"method": "GET", "path": "/admin/projects/{id}/timeTrackingSettings", "query": ["fields"], "response": "ProjectTimeTrackingSettings"},
    {"method": "POST", "path": "/issues", "query": ["fields"], "response": "Issue"},
    {"method": "POST", "path": "/issues/{id}", "query": ["fields"], "response": "Issue"},
    {"method": "POST", "path": "/issues/{id}/tags", "query": ["fields"], "response": "Tag"},
    {"method": "DELETE", "path": "/issues/{id}/tags/{tagId}", "query": [], "response": ""},
    {"method": "GET", "path": "/tags", "query": ["fields", "$skip", "$top"], "response": "Tag"},
    {"method": "GET", "path": "/admin/projects", "query": ["fields", "$skip", "$top"], "response": "Project"},
    {"method": "GET", "path": "/admin/projects/{id}/customFields", "query": ["fields", "$skip", "$top"], "response": "ProjectCustomField"},
    {"method": "GET", "path": "/admin/projects/{id}/customFields/{projectCustomFieldId}", "query": ["fields"], "response": "ProjectCustomField"},
    {"method": "POST", "path": "/commands", "query": ["fields"], "response": "CommandList"},
    {"method": "POST", "path": "/commands/assist", "query": ["fields"], "response": "CommandList"}
  ],
  "subtypes": {
    "IssueCustomField": [
      "SingleEnumIssueCustomField", "MultiEnumIssueCustomField", "StateIssueCustomField",
      "SingleUserIssueCustomField", "MultiUserIssueCustomField", "SingleGroupIssueCustomField", "MultiGroupIssueCustomField",
      "SingleVersionIssueCustomField", "MultiVersionIssueCustomField", "SingleBuildIssueCustomField", "MultiBuildIssueCustomField",
      "SingleOwnedIssueCustomField", "MultiOwnedIssueCustomField", "PeriodIssueCustomField", "DateIssueCustomField",
      "SimpleIssueCustomField", "TextIssueCustomField"
    ]
  },
  "types": {
    "Issue": {
      "id": [],
      "idReadable": [],
      "summary": [],
      "description": [],
      "project": ["Project"],
      "reporter": ["User"],
      "created": [],
      "updated": [],
      "resolved": [],
      "tags": ["Tag"],
      "commentsCount": [],
      "customFields": ["IssueCustomField"]
    },
    "IssueComment": {
      "id": [],
      "text": [],
      "author": ["User"],
      "created": [],
      "updated": [],
      "deleted": [],
      "issue": ["Issue"]
    },
    "IssueWorkItem": {
      "id": [],
      "date": [],
      "duration": ["DurationValue"],
      "author": ["User"],
      "type": ["WorkItemType"],
      "text": [],
      "issue": ["Issue"]
    },
    "DurationValue": {"minutes": [], "presentation": []},
    "WorkItemType": {"id": [], "name": []},
    "ProjectTimeTrackingSettings": {"enabled": [], "workItemTypes": ["WorkItemType"]},
    "Project": {"id": [], "shortName": [], "name": [], "archived": []},
    "User": {"login": [], "fullName": []},
    "Tag": {"id": [], "name": []},
    "IssueCustomField": {
      "name": [],
      "projectCustomField": ["ProjectCustomField"],
      "value": ["BundleElement", "User", "UserGroup", "PeriodValue", "TextFieldValue"]
    },
    "ProjectCustomField": {"id": [], "field": ["CustomField"], "canBeEmpty": [], "bundle": ["Bundle"]},
    "CustomField": {"name": [], "fieldType": ["FieldType"]},
    "FieldType": {"id": []},
    "BundleElement": {"name": [], "archived": []},
    "Bundle": {"values": ["BundleElement"], "aggregatedUsers": ["User"], "groups": ["UserGroup"]},
    "CommandList": {"query": [], "caret": [], "comment": [], "silent": [], "issues": ["Issue"], "commands": ["ParsedCommand"]},
    "ParsedCommand": {"description": [], "error": [], "delete": []},
    "UserGroup": {"name": []},
    "PeriodValue": {"minutes": [], "presentation": []},
    "TextFieldValue": {"text": []}
  }
}
