{
  "$comment": "The YouTrack REST API surface ytrack uses, written by hand from the public API docs (https://www.jetbrains.com/help/youtrack/devportal/youtrack-rest-api.html). Endpoints list the query parameters ytrack sends and the entity they return (empty when ytrack reads no body). Types list the attributes ytrack requests in fields= or writes in a request body ($type, the discriminator every entity has, is implied as an attribute; the $type values ytrack writes are listed under subtypes, by the type they specialize), each with the entity types it may hold (empty for a scalar). Writes list, by entity, the attributes ytrack sets at the top level of a JSON request body (nested objects there are references or values, named by their key attributes, not writes); an endpoint with body \"reference\" adds an existing entity to a collection, so its body names that entity and writes nothing. readOnlyWrites lists the written attributes the OpenAPI description marks readOnly but YouTrack accepts, each with its evidence. internal/youtrack/adapter/contract_test.go checks every request against this file; the weekly openapi-contract workflow checks this file against the live schemas and fails on a written attribute marked readOnly.",
  "endpoints": [
    {"method": "GET", "path": "/users/me", "query": ["fields"], "response": "User"},
    {"method": "GET", "path": "/issues", "query": ["fields", "query", "customFields", "$skip", "$top"], "response": "Issue"},
    {"method": "GET", "path": "/issues/{id}", "query": ["fields"], "response": "Issue"},
    {"method": "GET", "path": "/issues/{id}/comments", "query": ["fields", "$skip", "$top"], "response": "IssueComment"},
    {"method": "POST", "path": "/issues/{id}/comments", "query": ["fields"], "response": "IssueComment"},
    {"method": "GET", "path": "/issues/{id}/comments/{issueCommentId}", "query": ["fields"], "response": "IssueComment"},
    {"method": "POST", "path": "/issues/{id}/comments/{issueCommentId}", "query": ["fields"], "response": "IssueComment"},
    {"method": "DELETE", "path": "/issues/{id}/comments/{issueCommentId}", "query": [], "response": ""},
    {"method": "POST", "path": "/issues/{id}/attachments", "query": ["fields"], "response": "IssueAttachment"},
    {"method": "GET", "path": "/issues/{id}/attachments", "query": ["fields", "$skip", "$top"], "response": "IssueAttachment"},
    {"method": "GET", "path": "/issues/{id}/timeTracking/workItems", "query": ["fields", "$skip", "$top"], "response": "IssueWorkItem"},
    {"method": "POST", "path": "/issues/{id}/timeTracking/workItems", "query": ["fields"], "response": "IssueWorkItem"},
    {"method": "GET", "path": "/issues/{id}/timeTracking/workItems/{issueWorkItemId}", "query": ["fields"], "response": "IssueWorkItem"},
    {"method": "POST", "path": "/issues/{id}/timeTracking/workItems/{issueWorkItemId}", "query": ["fields"], "response": "IssueWorkItem"},
    {"method": "DELETE", "path": "/issues/{id}/timeTracking/workItems/{issueWorkItemId}", "query": [], "response": ""},
    {"method": "GET", "path": "/admin/projects/{id}/timeTrackingSettings", "query": ["fields"], "response": "ProjectTimeTrackingSettings"},
    {"method": "GET", "path": "/admin/timeTrackingSettings/workTimeSettings", "query": ["fields"], "response": "WorkTimeSettings"},
    {"method": "POST", "path": "/issues", "query": ["fields"], "response": "Issue"},
    {"method": "POST", "path": "/issues/{id}", "query": ["fields"], "response": "Issue"},
    {"method": "DELETE", "path": "/issues/{id}", "query": [], "response": ""},
    {"method": "POST", "path": "/issues/{id}/tags", "query": ["fields"], "response": "Tag", "body": "reference"},
    {"method": "DELETE", "path": "/issues/{id}/tags/{tagId}", "query": [], "response": ""},
    {"method": "GET", "path": "/tags", "query": ["fields", "$skip", "$top"], "response": "Tag"},
    {"method": "GET", "path": "/admin/projects", "query": ["fields", "$skip", "$top"], "response": "Project"},
    {"method": "GET", "path": "/admin/projects/{id}/customFields", "query": ["fields", "$skip", "$top"], "response": "ProjectCustomField"},
    {"method": "GET", "path": "/admin/projects/{id}/customFields/{projectCustomFieldId}", "query": ["fields"], "response": "ProjectCustomField"},
    {"method": "POST", "path": "/commands", "query": ["fields"], "response": "CommandList"},
    {"method": "POST", "path": "/commands/assist", "query": ["fields"], "response": "CommandList"},
    {"method": "GET", "path": "/issueLinkTypes", "query": ["fields", "$skip", "$top"], "response": "IssueLinkType"},
    {"method": "GET", "path": "/issues/{id}/links", "query": ["fields", "$skip", "$top"], "response": "IssueLink"},
    {"method": "GET", "path": "/issues/{id}/links/{issueLinkId}/issues", "query": ["fields", "$skip", "$top"], "response": "Issue"},
    {"method": "POST", "path": "/issues/{id}/links/{issueLinkId}/issues", "query": ["fields"], "response": "Issue", "body": "reference"},
    {"method": "DELETE", "path": "/issues/{id}/links/{issueLinkId}/issues/{issueId}", "query": [], "response": ""}
  ],
  "undocumented": [
    {"$comment": "Uploads files to a comment (multipart, like POST /issues/{id}/attachments). The comment's attachments collection is missing from /api/openapi.json, so the openapi-contract workflow does not check it; a GET of it answers the comment's files on YouTrack Cloud (an unknown sub-resource answers 'No subresource for path'), and YouTrack ignores the other ways to attach a file to a comment (files inside the create-comment JSON, attachment IDs in a comment update; issues #31 and #44).", "method": "POST", "path": "/issues/{id}/comments/{issueCommentId}/attachments", "query": ["fields"], "response": "IssueAttachment"}
  ],
  "files": [
    {"$comment": "An attachment's signed url (IssueAttachment.url): a path from the server root, service path included, that ytrack fetches as is. It serves the file's bytes and is not part of /api/openapi.json, so the openapi-contract workflow does not check it.", "method": "GET", "path": "/files/{fileId}", "query": ["sign", "updated"], "response": ""}
  ],
  "writes": {
    "Issue": ["summary", "description", "project", "tags", "customFields"],
    "IssueComment": ["text"],
    "IssueWorkItem": ["date", "duration", "type", "text"],
    "CommandList": ["query", "issues", "comment", "silent", "caret"]
  },
  "readOnlyWrites": {
    "Issue": {
      "customFields": "JetBrains' REST API docs set custom fields by posting customFields in the issue body (Create an issue, Update an issue), and ytrack issue create/edit --field relies on it; /api/openapi.json (2026.2 and 2026.4) still marks Issue.customFields readOnly."
    }
  },
