  "require": [
    {
      "name": "issue create with the description on stdin",
      "match": [
        "^issue create\\b",
        "(--project|-p) APP\\b",
        "(--description-file|-F) -(\\s|$)"
      ]
    },
    {
      "name": "the description piped from ls",
      "on": "commands",
      "match": [
        "\\bls\\b[^|;&\\n]*\\|[^|;&\\n]*\\bytrack\\b[^\\n]*\\bissue create\\b"
      ]
    }
  ],
  "forbid": [
    {
      "name": "no curl or web scraping",
      "on": "commands",
      "match": [
        "\\b(curl|wget)\\b"
      ]
    },
    {
      "name": "a raw API call where a command exists",
      "match": [
        "^api\\b"
      ]
    },
    {
      "name": "the issue created twice",
      "match": [
        "^issue create\\b"
      ],
      "not": [
        "--help|-h\\b"
      ],
      "times": 2
    }
  ]
}
