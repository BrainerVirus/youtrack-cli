    "rules": [
      {
        "match": "^project fields\\b.*(--json|--jq|--template)",
        "stdout": "[\n  {\n    \"id\": \"93-1\",\n    \"name\": \"Priority\",\n    \"type\": \"enum[1]\",\n    \"bundle\": [\n      \"Minor\",\n      \"Normal\",\n      \"Major\",\n      \"Critical\"\n    ],\n    \"required\": true,\n    \"default\": [\n      \"Normal\"\n    ]\n  },\n  {\n    \"id\": \"93-2\",\n    \"name\": \"Type\",\n    \"type\": \"enum[1]\",\n    \"bundle\": [\n      \"Bug\",\n      \"Feature\",\n      \"Task\"\n    ],\n    \"required\": true,\n    \"default\": [\n      \"Bug\"\n    ]\n  },\n  {\n    \"id\": \"93-3\",\n    \"name\": \"State\",\n    \"type\": \"state[1]\",\n    \"bundle\": [\n      \"Open\",\n      \"In Progress\",\n      \"Verify on staging\",\n      \"Fixed\"\n    ],\n    \"required\": true,\n    \"default\": [\n      \"Open\"\n    ]\n  },\n  {\n    \"id\": \"93-4\",\n    \"name\": \"Severity\",\n    \"type\": \"enum[1]\",\n    \"bundle\": [\n      \"Cosmetic\",\n      \"Minor\",\n      \"Normal\",\n      \"Major\",\n      \"Show-stopper\"\n    ],\n    \"required\": false,\n    \"default\": null\n  },\n  {\n    \"id\": \"93-5\",\n    \"name\": \"Assignee\",\n    \"type\": \"user[1]\",\n    \"bundle\": [],\n    \"required\": false,\n    \"default\": null\n  }\n]\n"
      },
      {
        "match": "^project fields\\b",
        "stdout": "Priority\tenum[1]\tyes\tNormal\tMinor, Normal, Major, Critical\nType\tenum[1]\tyes\tBug\tBug, Feature, Task\nState\tstate[1]\tyes\tOpen\tOpen, In Progress, Verify on staging, Fixed\nSeverity\tenum[1]\t\t\tCosmetic, Minor, Normal, Major, Show-stopper\nAssignee\tuser[1]\t\t\t\n"
      },
      {
        "match": "^issue create\\b.*--field Severity=Show-stopper\\b",
        "stdout": "https://acme.youtrack.cloud/issue/APP-130\n",
        "stderr": "✓ Created APP-130\n"
      },
      {
        "match": "^issue create\\b.*--field Severity=",
        "stderr": "ytrack: field Severity has no value matching the one given; `ytrack project fields APP` lists its values\nnothing was created\n",
        "exit": 1
      }
    ]
  },
  "require": [
    {
      "name": "project fields before the create",
      "match": [
        "^project fields (APP|Application)\\b"
      ],
      "before": [
        "^issue create\\b"
      ]
    },
    {
      "name": "issue create with Severity=Show-stopper",
      "match": [
        "^issue create\\b",
        "(-p|--project) APP\\b",
        "--field Severity=Show-stopper\\b"
      ]
    }
  ],
  "forbid": [
    {
      "name": "no curl or web scraping",
      "on": "commands",
      "match": [
        "\\b(curl|wget)\\b"
      ]
    },
    {
      "name": "a raw API call where a command exists",
      "match": [
        "^api\\b"
      ]
    },
    {
      "name": "the issue created twice",
      "match": [
        "^issue create\\b"
      ],
      "not": [
        "--help|-h\\b"
      ],
      "times": 2
    }
  ]
}
